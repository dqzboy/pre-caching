# 预缓存配置
# 复制：cp precache.env.example precache.env，修改后由 run_precache.sh 自动加载。
# 优先级：环境变量 > precache.env > 默认值。可选项取消行首 # 即可启用。
# 首次运行建议 LIMIT=10、RECHECK=0，小批量确认后再全量运行。

# --- 站点设置 ---
SITEMAP_URL="https://www.example.com/sitemap.xml"  # 必填：替换为真实站点地图
CACHE_HEADER="x-cache"                          # 缓存响应头；Cloudflare 用 cf-cache-status

# --- 请求与速度（以下数值为默认值）---
#CONCURRENCY=1      # 并发 worker 数
#RATE=1             # 全局 QPS 上限，所有 worker 共用；0 不限速
#DELAY=1000         # 每次请求完成后的全局最小休息，毫秒
#REST_RATIO=1       # 非 HIT 按耗时倍数休息，与 DELAY 取较大值；0 关闭
#TIMEOUT=10         # 单请求超时，秒
#RETRY=1            # 失败重试次数；超时不重试

# --- 压力保护 ---
#MAX_LATENCY=3s     # 达到此耗时触发冷却；0 关闭慢响应和首次超时保护
#COOLDOWN=10s       # 慢响应后的全局冷却时长
#MAX_SLOW=3         # 连续慢响应中止次数；0 不按次数中止，首次超时仍中止
#MAX_FAIL=3         # 连续请求失败中止次数，重试也计数；0 关闭
#SLOW_RATIO=3       # 平均耗时超过基线的倍数，达到后降低并发；0 关闭
#SLOW_THRESHOLD=2s  # 慢页面榜单阈值，仅影响显示；超时始终列出
#MAX_ERROR_RATE=0   # 首轮或复检的 5xx / 429 / 网络异常率阈值（%）；0 不检查

# --- 页面筛选与复检 ---
#LIMIT=                         # 仅处理前 N 页；留空或 0 表示全部
#EXCLUDE="/ads,/members"        # 按 URL 子串排除，逗号分隔；默认不排除
#LASTMOD=0                      # 仅预热最近变更页面，如 24h；0 全部，无 lastmod 仍请求
#RECHECK=0                      # 预热后等待多久再复检，如 5s / 2m；0 不复检
#JSON_OUT="/opt/pre-caching/last-report.json"  # JSON 报告路径；默认不生成

# --- 超时页面自动排除 ---
# 默认同一 URL 连续 3 天超时后自动排除，同一天重复超时只计 1 天。
#NO_LEARN=0                     # 1 关闭自动学习
#LEARN_FILE="/opt/pre-caching/slow-pages.txt"  # 默认：脚本目录/slow-pages.txt

# --- 日志 ---
# 每天或达到大小阈值时轮转，当前文件之外最多保留 1 份 .1 备份。
# 超过保留天数的日志按文件修改时间清理；下次运行时生效，不保证留满 7 天。
#LOG_FILE="/opt/pre-caching/pre-cache.log"  # 默认：脚本目录/pre-cache.log；none 关闭
#CRON_LOG="/opt/pre-caching/cron.log"       # 默认：脚本目录/cron.log；需将输出重定向到此路径
#LOG_MAX_BYTES=5242880                     # 两种日志的轮转大小，字节；默认 5MiB
#LOG_RETENTION_DAYS=7                      # 日志保留天数，默认 7

# --- 其他 ---
#VERIFY_SSL=0                   # 1 校验 SSL 证书，默认 0
#EXTRA_ARGS="-host=10.0.0.5:80"  # 附加二进制参数；默认无，示例为直连源站
